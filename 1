#include <iostream>
#include <vector>
#include <iomanip>

using namespace std;

int main() {
    int rows, cols;
    cout << "Введите количество строк и столбцов массива: ";
    cin >> rows >> cols;

    if (rows <= 0 || cols <= 0) {
        cout << "Ошибка: размеры массива должны быть натуральными числами." << endl;
        return 1;
    }

    vector<vector<double>> arr(rows, vector<double>(cols));
    cout << "Введите элементы массива (" << rows << "x" << cols << "):" << endl;
    for (int i = 0; i < rows; ++i) {
        for (int j = 0; j < cols; ++j) {
            cin >> arr[i][j];
        }
    }

    int max_row = 0;
    double max_product = -1.0;

    for (int i = 0; i < rows; ++i) {
        double prod = 1.0;
        for (int j = 0; j < cols; ++j) {
            prod *= arr[i][j] * arr[i][j];
        }

        if (i == 0 || prod > max_product) {
            max_product = prod;
            max_row = i;
        }
    }

    cout << fixed << setprecision(6);
    cout << "Строка с максимальным произведением квадратов элементов: " << (max_row + 1)
         << " (индекс " << max_row << ")" << endl;
    cout << "Максимальное произведение квадратов: " << max_product << endl;

    return 0;
}
